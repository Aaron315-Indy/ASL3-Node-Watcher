[general]
local_nodes = AUTO
ami_host = 127.0.0.1
ami_port = 5038
ami_username = asl3-node-watcher
ami_password = REPLACE_ME
poll_seconds = 3
command_timeout_seconds = 30
max_parallel_scripts = 4
log_level = INFO

; Replace these example remote nodes with the ones you monitor.
;[node:520359]
;on_connect = /etc/asterisk/scripts/520359-CONNECTED.sh
;on_disconnect = /etc/asterisk/scripts/520359-DISCONNECTED.sh
